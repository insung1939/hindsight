# 각 서비스 폴더의 .env (로컬) 또는 배포 환경변수. 값은 절대 커밋하지 않는다.
DATABASE_URL=                 # 비우면 SQLite. 배포: Supabase Session pooler 주소
ALLOWED_ORIGINS=http://localhost:5173
INTERNAL_TOKEN=dev-token      # /internal/* 호출용. 네 서비스 + GitHub Secrets 동일 값
MARKET_DATA_URL=http://localhost:8001
YOUTUBE_URL=http://localhost:8002
MENTIONS_URL=http://localhost:8003
STATS_URL=http://localhost:8004
YOUTUBE_API_KEY=              # services/youtube/.env — Google Cloud 콘솔에서 발급 (PLAN.md 3장)
DART_KEY=                     # services/market-data/.env — 상장사 사전 (없으면 시드 57개만)
DATA_GO_KR_KEY=               # services/market-data/.env — 국내 시세 (없으면 Yahoo 국내 심볼로 대체)
# OTEL_EXPORTER_OTLP_ENDPOINT=  # 있으면 OpenTelemetry 켜짐
