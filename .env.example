# 각 서비스 폴더의 .env 또는 배포 환경변수. 값은 절대 커밋하지 않는다.
DATABASE_URL=                 # 비우면 SQLite. 배포: Supabase Session pooler 주소
ALLOWED_ORIGINS=http://localhost:5173
INTERNAL_TOKEN=dev-token      # /internal/* 호출용. 다섯 서비스 + GitHub Secrets 동일 값
MARKET_DATA_URL=http://localhost:8001
INCOME_URL=http://localhost:8002
PORTFOLIO_URL=http://localhost:8003
DATA_GO_KR_KEY=               # 공공데이터포털 (국내 시세)
KOREAEXIM_KEY=                # 한국수출입은행 (공식 환율)
DART_KEY=                     # DART (배당 공시)
# OTEL_EXPORTER_OTLP_ENDPOINT=  # 5주차: 있으면 OpenTelemetry 켜짐
